{
  "$schema": "https://serein.viceverse.cz/schemas/extension-manifest.json",
  "id": "friend-codes",
  "name": "Friend Codes",
  "version": "1.0.0",
  "authors": [
    "VenSerein Contributors"
  ],
  "entrypoint": "friend_codes.wasm",
  "capabilities": [
    "storage",
    "composer"
  ],
  "actions": [
    {
      "id": "paste-code",
      "title": "Paste Friend Code",
      "surface": "composer",
      "label": "Friend Code"
    },
    {
      "id": "manage-codes",
      "title": "Manage Friend Codes",
      "surface": "panel",
      "label": "Codes Panel"
    }
  ],
  "api_version": 1,
  "kind": "plugin",
  "author": "VenSerein Contributors",
  "license": "MIT OR Apache-2.0",
  "source": "https://github.com/ViceVerse-cz/Serein",
  "description": "Store and quickly paste gaming friend codes (Steam, Switch, PSN, Xbox)."
}