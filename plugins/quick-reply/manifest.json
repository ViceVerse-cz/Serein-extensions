{
  "api_version": 1,
  "id": "quick-reply",
  "name": "Quick Reply & Canned Responses (VenSerein)",
  "version": "1.0.0",
  "author": "VenSerein Team",
  "license": "MIT OR Apache-2.0",
  "source": "https://github.com/Vendicated/Vencord/tree/main/src/plugins/quickReply",
  "kind": "plugin",
  "capabilities": [
    "composer",
    "storage"
