{
  "$schema": "https://serein.viceverse.cz/schemas/extension-manifest.json",
  "id": "auto-zipper",
  "name": "Auto Zipper",
  "version": "1.0.0",
  "authors": [
    "VenSerein Contributors"
  ],
  "entrypoint": "auto_zipper.wasm",
  "capabilities": [
    "composer"
  ],
  "actions": [
    {
      "id": "toggle-auto-zip",
      "title": "Toggle Auto-Zip",
      "surface": "composer",
      "label": "Auto-Zip"
    }
  ],
  "api_version": 1,
  "kind": "plugin",
  "author": "VenSerein Contributors",
  "license": "MIT OR Apache-2.0",
  "source": "https://github.com/ViceVerse-cz/Serein",
  "description": "Auto-zip batches of files before upload when multiple files are selected."
}