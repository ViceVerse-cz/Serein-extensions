{
  "$schema": "https://serein.viceverse.cz/schemas/extension-manifest.json",
  "id": "guild-picker-dumper",
  "name": "Guild Picker Dumper",
  "version": "1.0.0",
  "authors": [
    "VenSerein Contributors"
  ],
  "entrypoint": "guild_picker_dumper.wasm",
  "capabilities": [
    "storage",
    "composer"
  ],
  "actions": [
    {
      "id": "dump-ids",
      "title": "Dump Guild IDs to Chat",
      "surface": "composer",
      "label": "Dump IDs"
    },
    {
      "id": "dump-panel",
      "title": "Guild Dumper Panel",
      "surface": "panel",
      "label": "Guild Dumper"
    }
  ],
  "api_version": 1,
  "kind": "plugin",
  "author": "VenSerein Contributors",
  "license": "MIT OR Apache-2.0",
  "source": "https://github.com/ViceVerse-cz/Serein",
  "description": "Dump channel, role, and emoji IDs of current guild to JSON format."
}