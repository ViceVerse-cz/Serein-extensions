{
  "$schema": "https://serein.viceverse.cz/schemas/extension-manifest.json",
  "id": "better-ban-reasons",
  "name": "Better Ban Reasons",
  "version": "1.0.0",
  "authors": [
    "VenSerein Contributors"
  ],
  "entrypoint": "better_ban_reasons.wasm",
  "capabilities": [
    "storage",
    "composer"
  ],
  "actions": [
    {
      "id": "ban-template",
      "title": "Insert Ban Reason Template",
      "surface": "composer",
      "label": "Ban Template"
    },
    {
      "id": "manage-reasons",
      "title": "Manage Ban Reasons",
      "surface": "panel",
      "label": "Ban Reasons"
    }
  ],
  "api_version": 1,
  "kind": "plugin",
  "author": "VenSerein Contributors",
  "license": "MIT OR Apache-2.0",
  "source": "https://github.com/ViceVerse-cz/Serein",
  "description": "Templates and presets for moderator ban and kick reasons."
}