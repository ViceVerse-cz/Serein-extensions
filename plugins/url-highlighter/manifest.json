{
  "$schema": "https://serein.viceverse.cz/schemas/extension-manifest.json",
  "id": "url-highlighter",
  "name": "URL Highlighter",
  "version": "1.0.0",
  "authors": [
    "VenSerein Contributors"
  ],
  "entrypoint": "url_highlighter.wasm",
  "capabilities": [
    "storage"
  ],
  "actions": [
    {
      "id": "toggle",
      "title": "Toggle URL Highlights",
      "surface": "panel",
      "label": "URL Highlights"
    }
  ],
  "api_version": 1,
  "kind": "plugin",
  "author": "VenSerein Contributors",
  "license": "MIT OR Apache-2.0",
  "source": "https://github.com/ViceVerse-cz/Serein",
  "description": "Highlight and categorize URLs in chat (safe, tracking, shortened, etc.)."
}