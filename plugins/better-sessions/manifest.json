{
  "$schema": "https://serein.viceverse.cz/schemas/extension-manifest.json",
  "id": "better-sessions",
  "name": "Better Sessions & Device Hub",
  "version": "1.0.0",
  "authors": [
    "VenSerein Contributors"
  ],
  "entrypoint": "better_sessions.wasm",
  "capabilities": [
    "storage",
    "composer"
  ],
  "actions": [
    {
      "id": "manage-sessions",
      "title": "Device Sessions & Security Audit",
      "surface": "panel",
      "label": "Manage Sessions"
