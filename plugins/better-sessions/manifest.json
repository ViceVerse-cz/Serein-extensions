    {
      "id": "expand-sessions",
      "title": "Insert Sessions Report",
      "surface": "composer",
      "label": "Expand Sessions"
    }
  ],
  "api_version": 1,
  "kind": "plugin",
  "author": "VenSerein contributors",
  "license": "MIT OR Apache-2.0",
  "source": "https://github.com/ViceVerse-cz/Serein"
}
