{
  "$schema": "https://serein.viceverse.cz/schemas/extension-manifest.json",
  "id": "sed-enhanced",
  "name": "Sed Enhanced",
  "version": "1.0.0",
  "authors": [
    "VenSerein Contributors"
  ],
  "entrypoint": "sed_enhanced.wasm",
  "capabilities": [
    "storage",
    "composer"
  ],
  "actions": [
    {
      "id": "sed-replace",
      "title": "Sed Replace",
      "surface": "composer",
      "label": "s/\u2026/\u2026/"
    },
    {
      "id": "history",
      "title": "Replacement History",
      "surface": "panel",
      "label": "History"
    }
  ],
  "api_version": 1,
  "kind": "plugin",
  "author": "VenSerein Contributors",
  "license": "MIT OR Apache-2.0",
  "source": "https://github.com/ViceVerse-cz/Serein",
  "description": "Apply regex sed-style replacements (s/was/is/g) to the last sent message."
}