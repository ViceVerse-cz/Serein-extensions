{
  "api_version": 1,
  "id": "clear-urls",
  "name": "Clear URLs (VenSerein)",
  "version": "1.0.0",
  "author": "VenSerein Team",
  "license": "MIT OR Apache-2.0",
  "source": "https://github.com/Vendicated/Vencord/tree/main/src/plugins/clearURLs",
